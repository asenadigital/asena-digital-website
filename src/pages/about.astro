---
import Base from "@/layouts/Base.astro";
---
<Base title="About Asena Digital" meta_title="About Us | Asena Digital" description="Learn about Asena Digital, a global-minded technology and digital solutions company based in Ankara, Türkiye.">
  <section class="section-ph pb-16"><div class="container pt-24"><p class="mb-5 text-xs uppercase tracking-[.25em] text-white/40">About Asena Digital</p><h1 class="max-w-4xl text-5xl font-semibold leading-tight tracking-tight text-white sm:text-7xl">We turn ambitious ideas into <span class="text-white/45">useful technology.</span></h1><p class="mt-8 max-w-2xl text-lg leading-8 text-white/60">Asena Digital is a technology and digital solutions company focused on helping businesses design, build and improve the digital systems they rely on.</p></div></section>
  <section class="section border-t border-white/10"><div class="container grid gap-12 lg:grid-cols-2"><div><p class="mb-4 text-xs uppercase tracking-[.25em] text-white/40">Our purpose</p><h2 class="text-4xl font-semibold text-white">Technology should make progress easier.</h2></div><div class="space-y-5 text-base leading-8 text-white/60"><p>We bring together thoughtful design, reliable engineering and a practical understanding of business needs. Our work spans digital experiences, custom software, commerce platforms, mobile applications and AI-enabled workflows.</p><p>We believe successful technology is not defined by complexity. It is defined by how clearly it solves a problem, how confidently people can use it and how well it adapts as a business grows.</p></div></div></section>
  <section class="section border-t border-white/10"><div class="container"><p class="mb-4 text-xs uppercase tracking-[.25em] text-white/40">What guides us</p><div class="grid gap-4 md:grid-cols-3">{[['Thoughtful by design','We start with people, context and outcomes — not technology for its own sake.'],['Built to be dependable','We value clear communication, maintainable systems and careful execution.'],['Ready for what is next','We create flexible foundations that can evolve with your business.']].map(([t,d],i)=><div class="rounded-3xl border border-white/10 bg-white/[.03] p-7"><div class="mb-10 text-xs text-white/35">0{i+1}</div><h3 class="mb-3 text-xl font-semibold text-white">{t}</h3><p class="text-sm leading-7 text-white/55">{d}</p></div>)}</div></div></section>
  <section class="section border-t border-white/10"><div class="container rounded-3xl border border-white/10 bg-white/[.03] p-8 sm:p-12"><p class="mb-4 text-xs uppercase tracking-[.25em] text-white/40">Where we are</p><h2 class="text-3xl font-semibold text-white">Based in Ankara. Working worldwide.</h2><p class="mt-5 max-w-2xl leading-7 text-white/55">Asena Digital is based in Çankaya, Ankara, Türkiye, and works with clients and partners across international markets.</p><a href="/contact" class="mt-8 inline-flex rounded-full bg-[#e5e7e9] px-7 py-3.5 text-sm font-semibold text-black">Get in touch ↗</a></div></section>
</Base>
