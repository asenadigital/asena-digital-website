---
import Base from "@/layouts/Base.astro";
const groups = [
  { title: "Website Development", from: "$1,500", note: "For professional websites and landing pages.", items: ["Landing page — from $1,500", "Corporate website (5–8 pages) — from $2,500", "Advanced corporate website — from $4,500", "Bilingual website — from $3,500"] },
  { title: "E-commerce Solutions", from: "$5,000", note: "For brands building or improving their online store.", items: ["Starter online store — from $5,000", "Growth e-commerce — from $8,000", "Custom commerce & integrations — from $12,000"] },
  { title: "Custom Software", from: "$8,000", note: "Scope-based development for business-specific workflows.", items: ["Internal tools & admin panels — from $8,000", "Customer portals & web platforms — from $15,000", "SaaS MVP development — from $20,000"] },
  { title: "Mobile Applications", from: "$12,000", note: "Product design and app development for iOS and Android.", items: ["Clickable app prototype — from $2,500", "Cross-platform MVP — from $12,000", "Feature-rich mobile product — from $25,000"] },
  { title: "AI & Automation", from: "$2,000", note: "Practical AI features and process automation.", items: ["Workflow automation — from $2,000", "AI chatbot / assistant integration — from $4,000", "Custom AI-enabled platform — from $12,000"] },
  { title: "Technology Consulting", from: "$75/hr", note: "Technical direction and independent expertise.", items: ["Technical consultation — from $75/hour", "Architecture & product review — from $750", "Dedicated development support — custom retainer"] }
];
---
<Base title="Pricing | Asena Digital" meta_title="Services & Pricing | Asena Digital" description="Indicative USD starting prices for website development, e-commerce, custom software, mobile apps, AI and technology consulting.">
  <section class="section-ph pb-14"><div class="container pt-24 text-center"><p class="mb-5 text-xs uppercase tracking-[.25em] text-white/40">Services & investment</p><h1 class="mx-auto max-w-4xl text-5xl font-semibold tracking-tight text-white sm:text-7xl">Straightforward starting prices.<br/><span class="text-white/45">Tailored delivery.</span></h1><p class="mx-auto mt-7 max-w-2xl leading-8 text-white/55">The prices below are indicative starting points in USD. Final proposals are based on scope, integrations, content, design requirements and delivery timeline.</p></div></section>
  <section class="section border-t border-white/10"><div class="container grid gap-4 md:grid-cols-2 xl:grid-cols-3">{groups.map((g,i)=><article class="rounded-3xl border border-white/10 bg-white/[.03] p-7"><div class="mb-8 flex items-start justify-between"><span class="text-xs uppercase tracking-[.18em] text-white/40">0{i+1} / Service</span><span class="text-2xl text-white/50">↗</span></div><h2 class="mb-2 text-2xl font-semibold text-white">{g.title}</h2><p class="mb-6 text-sm leading-6 text-white/50">{g.note}</p><p class="mb-6 text-3xl font-semibold text-white">From {g.from}</p><ul class="space-y-3 border-t border-white/10 pt-6">{g.items.map(item=><li class="text-sm leading-6 text-white/70">{item}</li>)}</ul><a href={`/contact?service=${encodeURIComponent(g.title)}`} class="mt-8 block rounded-full border border-white/20 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-white hover:text-black">Request a quote</a></article>)}</div>
    <div class="container mt-12 rounded-3xl border border-white/10 bg-white/[.025] p-7 sm:p-9"><h2 class="text-xl font-semibold text-white">A note on pricing</h2><p class="mt-3 max-w-4xl text-sm leading-7 text-white/55">These are planning estimates, not fixed offers or guaranteed delivery quotes. Third-party subscriptions, hosting, domains, payment-provider fees, paid plugins, stock assets, taxes and ongoing maintenance are not included unless explicitly stated in a proposal. Projects with advanced compliance, large-scale infrastructure or complex integrations require a discovery phase and a custom quote.</p></div>
  </section>
</Base>
